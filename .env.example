APP_ENV=development
FLASK_APP=wsgi.py
FLASK_DEBUG=1
PORT=5000

SECRET_KEY=troque-por-uma-chave-local-longa-e-aleatoria
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800

POSTGRES_DB=click_nfe
POSTGRES_USER=click_nfe
POSTGRES_PASSWORD=click_nfe
POSTGRES_PORT=5432
API_PORT=5000
DATABASE_URL=postgresql+psycopg2://click_nfe:click_nfe@localhost:5432/click_nfe

WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000

# Consulta pública e pontual de dados cadastrais por CNPJ.
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
BRASIL_API_TIMEOUT_SECONDS=8

# Bootstrap local. DEV_ADMIN_PASSWORD pode permanecer vazio para que o comando
# solicite a senha sem exibi-la no terminal.
DEV_ADMIN_ORGANIZATION_NAME=Click NFe Demo
DEV_ADMIN_ORGANIZATION_SLUG=click-nfe-demo
DEV_ADMIN_NAME=Administrador Local
DEV_ADMIN_EMAIL=admin@clicknfe.local
DEV_ADMIN_PASSWORD=

# Desenvolvimento local de integrações. O banco deve armazenar somente referências.
# Exemplo: credentials_ref=env:CLIENTE_EXEMPLO_PORTAL
# CLIENTE_EXEMPLO_PORTAL_CLIENT_ID=
# CLIENTE_EXEMPLO_PORTAL_CLIENT_SECRET=
# NFE_CLIENT_CERTIFICATE_PFX_BASE64=
# NFE_CLIENT_CERTIFICATE_PASSWORD=
