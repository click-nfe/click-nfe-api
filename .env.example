APP_ENV=development
FLASK_APP=wsgi.py
FLASK_DEBUG=1
PORT=5000

SECRET_KEY=troque-por-uma-chave-local-longa-e-aleatoria
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_SECONDS=604800

POSTGRES_DB=click_nfe
POSTGRES_USER=click_nfe
POSTGRES_PASSWORD=click_nfe
POSTGRES_PORT=5432
API_PORT=5000
DATABASE_URL=postgresql+psycopg2://click_nfe:click_nfe@localhost:5432/click_nfe

WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000

# Consulta pública e pontual de dados cadastrais por CNPJ.
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
BRASIL_API_TIMEOUT_SECONDS=8
VIA_CEP_BASE_URL=https://viacep.com.br
CEP_LOOKUP_TIMEOUT_SECONDS=4
CEP_CACHE_TTL_SECONDS=2592000

# Cofre local criptografado para o Client-Id e Client-Secret do Portal Único.
# Gere uma chave Fernet própria para PORTAL_UNICO_LOCAL_SECRET_KEY; se ficar
# vazia, o desenvolvimento deriva uma chave estável de SECRET_KEY.
PORTAL_UNICO_CREDENTIAL_STORAGE_PROVIDER=local_encrypted_file
PORTAL_UNICO_LOCAL_SECRET_DIR=/app/data/portal-unico
PORTAL_UNICO_LOCAL_SECRET_KEY=
PORTAL_UNICO_TIMEOUT_SECONDS=30

# Cofre local criptografado para certificados A1. Gere uma chave Fernet própria
# para NFE_LOCAL_CERTIFICATE_KEY; se ficar vazia, o desenvolvimento deriva uma
# chave estável de SECRET_KEY.
NFE_CERTIFICATE_STORAGE_PROVIDER=local_encrypted_file
NFE_LOCAL_CERTIFICATE_DIR=/app/data/certificates
NFE_LOCAL_CERTIFICATE_KEY=
NFE_CERTIFICATE_MAX_BYTES=2097152

# Bootstrap local. DEV_ADMIN_PASSWORD pode permanecer vazio para que o comando
# solicite a senha sem exibi-la no terminal.
DEV_ADMIN_ORGANIZATION_NAME=Click NFe Demo
DEV_ADMIN_ORGANIZATION_SLUG=click-nfe-demo
DEV_ADMIN_NAME=Administrador Local
DEV_ADMIN_EMAIL=admin@clicknfe.local
DEV_ADMIN_PASSWORD=

# Integrações legadas por referência. O cadastro normal do Portal Único deve ser
# feito pela rota organizacional, que grava o segredo no cofre local criptografado.
# Exemplo legado: credentials_ref=env:CLIENTE_EXEMPLO_PORTAL
# CLIENTE_EXEMPLO_PORTAL_CLIENT_ID=
# CLIENTE_EXEMPLO_PORTAL_CLIENT_SECRET=
# NFE_CLIENT_CERTIFICATE_PFX_BASE64=
# NFE_CLIENT_CERTIFICATE_PASSWORD=
